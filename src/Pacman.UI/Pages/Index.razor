@page "/"
@using Pacman.Core
@using Pacman.Core.Enums
@using Pacman.Core.Entities
@implements IDisposable
@inject IJSRuntime JS

<div class="game-frame" @onclick="HandleClick" @onclick:stopPropagation="true"
     tabindex="0" autofocus>
    <div class="game-header">
        <div class="hud-item">
            <span class="hud-label">Score</span>
            <span class="hud-value score-val">@(_engine?.Pacman.Score ?? 0)</span>
        </div>
        <div class="hud-item">
            <span class="hud-label">Status</span>
            <span class="hud-value state-val">@GetStateText()</span>
        </div>
        <div class="hud-item">
            <span class="hud-label">Lives</span>
            <span class="hud-value lives-val">@(_engine?.Pacman.Lives ?? 0)</span>
        </div>
    </div>

    <div class="game-board" style="width: @(MazeData.Width * 24)px; height: @(MazeData.Height * 24)px;">
        <div class="maze-grid" style="grid-template-columns: repeat(@MazeData.Width, 24px); grid-template-rows: repeat(@MazeData.Height, 24px);">
            @{
                var maze = _engine?.GetMaze() ?? MazeData.Grid;
                for (int y = 0; y < MazeData.Height; y++)
                {
                    for (int x = 0; x < MazeData.Width; x++)
                    {
                        int cell = maze[y, x];
                        string cls = cell switch
                        {
                            1 => "maze-cell wall",
                            0 => "maze-cell pellet",
                            2 => "maze-cell power-pellet",
                            _ => "maze-cell empty"
                        };
                        <div class="@cls" data-x="@x" data-y="@y"></div>
                    }
                }
            }
        </div>

        <div id="pacman" class="entity pacman-sprite"
             style="transform: translate(@(14 * 24)px, @(23 * 24)px);"></div>
        <div id="ghost-red" class="entity ghost-sprite ghost-red-sprite ghost-float"
             style="transform: translate(@(12 * 24)px, @(12 * 24)px);"></div>
        <div id="ghost-pink" class="entity ghost-sprite ghost-pink-sprite ghost-float"
             style="transform: translate(@(14 * 24)px, @(12 * 24)px);"></div>
        <div id="ghost-blue" class="entity ghost-sprite ghost-blue-sprite ghost-float"
             style="transform: translate(@(11 * 24)px, @(12 * 24)px);"></div>
        <div id="ghost-orange" class="entity ghost-sprite ghost-orange-sprite ghost-float"
             style="transform: translate(@(17 * 24)px, @(12 * 24)px);"></div>

        @if (_engine?.State == GameState.Start)
        {
            <div class="overlay">
                <div class="overlay-title">PAC-MAN</div>
                <div class="overlay-subtitle">8-BIT ARCADE EDITION</div>
                <button class="btn-arcade" @onclick="StartGame" @onclick:stopPropagation="true">START GAME</button>
                <div class="overlay-blink">PRESS W-A-S-D OR START BUTTON</div>
                <div class="controls-hint">
                    <span>W</span> UP &nbsp; <span>S</span> DOWN<br/>
                    <span>A</span> LEFT <span>D</span> RIGHT
                </div>
            </div>
        }
        else if (_engine?.State == GameState.GameOver)
        {
            <div class="overlay game-over">
                <div class="overlay-title">GAME OVER</div>
                <div class="final-score">SCORE: @_engine?.Pacman.Score</div>
                <button class="btn-arcade" @onclick="RestartGame" @onclick:stopPropagation="true">PLAY AGAIN</button>
            </div>
        }
        else if (_engine?.State == GameState.Win)
        {
            <div class="overlay win">
                <div class="overlay-title">YOU WIN!</div>
                <div class="final-score">SCORE: @_engine?.Pacman.Score</div>
                <button class="btn-arcade" @onclick="RestartGame" @onclick:stopPropagation="true">PLAY AGAIN</button>
            </div>
        }
    </div>
</div>

@code {
    private GameEngine? _engine;
    private DotNetObjectReference<Index>? _dotNetRef;
    private GameState _lastState = GameState.Start;

    protected override void OnInitialized()
    {
        _engine = new GameEngine();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("gameInterop.init", _dotNetRef);
            await JS.InvokeVoidAsync("gameInterop.startLoop");
            await JS.InvokeVoidAsync("gameInterop.focusGame");
        }
    }

    [JSInvokable]
    public List<EntityState> GameLoop(double deltaTime)
    {
        if (_engine == null) return new();
        var states = _engine.Update(deltaTime);

        var sounds = _engine.FlushSoundEvents();
        foreach (var sound in sounds)
            _ = JS.InvokeVoidAsync("gameInterop.playSound", sound);

        // Update pellets via JS for immediate visual feedback
        if (_engine.IsRunning)
        {
            var mazeJson = System.Text.Json.JsonSerializer.Serialize(_engine.GetMaze());
            _ = JS.InvokeVoidAsync("gameInterop.updatePellets", mazeJson);
        }

        // Only re-render Blazor on state transitions — keeps 60fps smooth
        if (_engine.State != _lastState)
        {
            _lastState = _engine.State;
            if (_engine.State == GameState.Playing)
                _ = JS.InvokeVoidAsync("gameInterop.playMusic");
            else if (_engine.State is GameState.Dying or GameState.GameOver or GameState.Win)
                _ = JS.InvokeVoidAsync("gameInterop.stopMusic");
            StateHasChanged();
        }

        return states;
    }

    [JSInvokable]
    public void HandleDirection(int dir)
    {
        if (dir < 1 || dir > 4) return;
        _ = JS.InvokeVoidAsync("gameInterop.resumeAudio");
        _engine?.HandleInput((Direction)dir);
    }

    private async Task HandleClick()
    {
        await JS.InvokeVoidAsync("gameInterop.focusGame");
        await JS.InvokeVoidAsync("gameInterop.resumeAudio");
    }

    private void StartGame()
    {
        _ = JS.InvokeVoidAsync("gameInterop.resumeAudio");
        _engine?.Start();
        _lastState = GameState.Playing;
    }

    private void RestartGame()
    {
        _engine?.Restart();
        _lastState = GameState.Start;
        _ = JS.InvokeVoidAsync("gameInterop.stopMusic");
        _ = JS.InvokeVoidAsync("gameInterop.resumeAudio");
    }

    private string GetStateText() => _engine?.State switch
    {
        GameState.Start => "READY!",
        GameState.Frightened => "FRIGHTENED!",
        GameState.GameOver => "GAME OVER",
        GameState.Win => "YOU WIN!",
        _ => ""
    };

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("gameInterop.stopLoop");
        _dotNetRef?.Dispose();
    }
}
